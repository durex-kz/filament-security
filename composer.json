{
    "name": "durex-kz/filament-security",
    "description": "Плагин Filament: журнал ошибок (durex-kz/error-monitor) и справочник заблокированных IP (durex-kz/bot-guard), виджеты для главной",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "error-log",
        "security"
    ],
    "authors": [
        {
            "name": "Aslan Tumenov",
            "homepage": "https://github.com/durex-kz"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/durex-kz/error-monitor"
        },
        {
            "type": "vcs",
            "url": "https://github.com/durex-kz/bot-guard"
        }
    ],
    "require": {
        "php": "^8.3",
        "durex-kz/bot-guard": "^0.1.9|^1.0",
        "durex-kz/error-monitor": "^0.1|^1.0",
        "filament/filament": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "DurexKz\\FilamentSecurity\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DurexKz\\FilamentSecurity\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DurexKz\\FilamentSecurity\\FilamentSecurityServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
